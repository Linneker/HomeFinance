<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear /> descarta as origens herdadas do NuGet.config global da máquina.
    Sem isso, o feed privado Azure DevOps configurado no ambiente responde 401 e derruba a
    restauração de qualquer pacote novo. Este projeto não consome pacote interno da Acme —
    quando passar a consumir, a origem entra aqui explicitamente, com credencial fora do
    repositório.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Descarta também as pastas de fallback herdadas da máquina (ex.: as do Visual Studio).
    Elas são caminhos Windows e não existem dentro do container de build, o que faz o
    publish falhar com "Unable to find fallback package folder".
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
