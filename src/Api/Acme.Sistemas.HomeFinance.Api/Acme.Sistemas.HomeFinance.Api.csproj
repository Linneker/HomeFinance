<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A tradução do rótulo do provedor para o evento do domínio é interna ao endpoint, mas
         carrega a decisão de segurança "desconhecido vira estorno" — testada pela integração. -->
    <InternalsVisibleTo Include="Acme.Sistemas.IntegrationTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flags de recurso na raiz do Api (convenção do blueprint). Copiado para a saída para o
         FeatureFlagService lê-lo em runtime; editar o arquivo (ou o ConfigMap que o monta) muda
         o comportamento sem novo build. -->
    <None Update="featureflags.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Service\Acme.Sistemas.Services\Acme.Sistemas.Services.csproj" />
    <ProjectReference Include="..\..\Service\Acme.Sistemas.Core\Acme.Sistemas.Core.csproj" />
    <ProjectReference Include="..\..\Service\Acme.Sistemas.Domain\Acme.Sistemas.Domain.csproj" />
    <ProjectReference Include="..\..\Data\Acme.Sistemas.Infrastructure\Acme.Sistemas.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Data\Acme.Sistemas.Repository\Acme.Sistemas.Repository.csproj" />
    <ProjectReference Include="..\..\Data\Acme.Sistemas.ExternalIntegration\Acme.Sistemas.ExternalIntegration.csproj" />
  </ItemGroup>

</Project>
