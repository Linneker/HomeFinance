<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.PlanosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Planos">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label
            Grid.Row="0"
            Text="Escolha um plano. A confirmação da compra é validada no servidor antes de liberar o recurso."
            TextColor="Gray" />

        <CollectionView Grid.Row="1" x:Name="Lista" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12" Padding="16" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Nome}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding DescricaoCota}" TextColor="Gray" />
                                <Label Text="{Binding PrecoTexto}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Contratar"
                                VerticalOptions="Center"
                                Clicked="AoContratar"
                                CommandParameter="{Binding Codigo}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <ActivityIndicator x:Name="Ocupado" IsRunning="False" IsVisible="False" />
            <Label x:Name="LabelMensagem" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
