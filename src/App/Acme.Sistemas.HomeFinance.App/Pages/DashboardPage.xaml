<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Início">

    <RefreshView x:Name="Atualizar" Refreshing="AoAtualizar">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Barra de somente leitura (13.7): visível e inequívoca quando o espaço é de consulta. -->
                <Border x:Name="BarraLeitura" IsVisible="False" BackgroundColor="#B7791F" StrokeShape="RoundRectangle 8" Padding="10">
                    <Label x:Name="LabelLeitura" TextColor="White" FontAttributes="Bold" />
                </Border>

                <!-- Assinatura não ativa (13.16): recursos derivados indisponíveis, com motivo e regularização. -->
                <Border x:Name="PainelAssinatura" IsVisible="False" BackgroundColor="#FDECEA" StrokeShape="RoundRectangle 8" Padding="12">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="LabelAssinatura" TextColor="#C23934" />
                        <Button Text="Regularizar" HorizontalOptions="Start" Clicked="AoRegularizar" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LabelMes" FontSize="22" FontAttributes="Bold" />

                <!-- Onboarding (13.13/13.15): some quando liberado. -->
                <Border x:Name="PainelOnboarding" IsVisible="False" StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Comece por aqui" FontAttributes="Bold" />
                        <ProgressBar x:Name="Progresso" />
                        <Label x:Name="LabelProgresso" FontSize="12" TextColor="Gray" />
                        <VerticalStackLayout x:Name="PassosPendentes" Spacing="2" />
                    </VerticalStackLayout>
                </Border>

                <!-- Resumo do mês -->
                <Border StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Resumo do mês" FontAttributes="Bold" />
                        <Label x:Name="LabelResumo" />
                        <Label x:Name="LabelResumoVazio" Text="Ainda sem lançamentos neste mês." TextColor="Gray" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Alertas -->
                <Border StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Alertas" FontAttributes="Bold" />
                        <Label x:Name="LabelAlertas" />
                        <Button Text="Ver alertas" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" HorizontalOptions="Start" Clicked="AoVerAlertas" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
