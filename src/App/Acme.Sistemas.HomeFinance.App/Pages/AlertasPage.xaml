<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.AlertasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Alertas">

    <RefreshView x:Name="Atualizar" Refreshing="AoAtualizar">
        <Grid>
            <CollectionView x:Name="Lista" SelectionMode="None" Margin="12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" VerticalOptions="Center">
                        <Label Text="Nenhum alerta aberto." HorizontalOptions="Center" TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" Padding="14" Margin="0,4" BackgroundColor="{Binding Cor}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding TipoTexto}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding Mensagem}" />
                                    <Label Text="{Binding Quando}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Dispensar"
                                    VerticalOptions="Center"
                                    Clicked="AoDispensar"
                                    CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
