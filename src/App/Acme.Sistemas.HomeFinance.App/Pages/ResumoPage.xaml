<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.ResumoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resumo">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,8" ColumnSpacing="8">
            <Button Grid.Column="0" Text="‹" Clicked="AoMesAnterior" WidthRequest="44" />
            <Label Grid.Column="1" x:Name="LabelMes" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
            <Button Grid.Column="2" Text="›" Clicked="AoProximoMes" WidthRequest="44" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="12,0,12,8">
            <Label Text="Visão:" VerticalOptions="Center" />
            <Label x:Name="LabelVisao" Text="Competência" FontAttributes="Bold" VerticalOptions="Center" />
            <Switch x:Name="SwitchCaixa" Toggled="AoAlternar" />
        </HorizontalStackLayout>

        <Border Grid.Row="2" Margin="12,0,12,8" Padding="12" StrokeShape="RoundRectangle 10">
            <Label x:Name="LabelTotais" />
        </Border>

        <RefreshView Grid.Row="3" x:Name="Atualizar" Refreshing="AoAtualizar">
            <CollectionView x:Name="Lista">
                <CollectionView.EmptyView>
                    <Label Text="Sem dados neste mês." Padding="24" HorizontalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding Detalhe}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Realizado}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{Binding Cor}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
