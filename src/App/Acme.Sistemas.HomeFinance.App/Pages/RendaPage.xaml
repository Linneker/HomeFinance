<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.RendaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Renda">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label x:Name="LabelPrevista" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="LabelErro" TextColor="Red" IsVisible="False" />

            <CollectionView x:Name="Lista">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma fonte de renda cadastrada." TextColor="Gray" Padding="8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding Detalhe}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding ValorTexto}" VerticalOptions="Center" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#DDD" />

            <Label Text="Nova fonte de renda" FontAttributes="Bold" FontSize="16" />
            <Entry x:Name="EntradaNome" Placeholder="Nome (ex.: Salário)" />
            <Entry x:Name="EntradaValor" Placeholder="Valor" Keyboard="Numeric" />
            <Entry x:Name="EntradaDia" Placeholder="Dia do recebimento (1–31)" Keyboard="Numeric" />
            <Button x:Name="BotaoAdicionar" Text="Adicionar" Clicked="AoAdicionar" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
