<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Acme.Sistemas.HomeFinance.App.Pages.CompartilhamentoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Compartilhamento">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label x:Name="LabelErro" TextColor="Red" IsVisible="False" />
            <Label x:Name="LabelCota" FontAttributes="Bold" />

            <!-- Compartilhamentos atuais -->
            <Label Text="Quem tem acesso" FontAttributes="Bold" FontSize="16" />
            <CollectionView x:Name="Lista">
                <CollectionView.EmptyView>
                    <Label Text="Você ainda não compartilhou este espaço." TextColor="Gray" Padding="4" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Titulo}" />
                                <Label Text="{Binding Subtitulo}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Revogar" Clicked="AoRevogar" CommandParameter="{Binding DestinatarioId}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#DDD" />

            <!-- Novo compartilhamento -->
            <Label Text="Compartilhar com alguém" FontAttributes="Bold" FontSize="16" />
            <Entry x:Name="EntradaEmail" Placeholder="E-mail de quem vai receber" Keyboard="Email" />

            <Label Text="O que ficará visível" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="PainelItens" Spacing="6" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="Confirmo" />
                <Label VerticalOptions="Center" Text="Confirmo que quero conceder este acesso somente leitura." LineBreakMode="WordWrap" />
            </HorizontalStackLayout>

            <Button x:Name="BotaoCompartilhar" Text="Compartilhar" Clicked="AoCompartilhar" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
